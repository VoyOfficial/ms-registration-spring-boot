# Copie este arquivo para .cursor/mcp.env e preencha os valores reais.
# .cursor/mcp.env NUNCA deve ser commitado (ja esta no .gitignore).

# --- Obsidian MCP (obrigatorio para a skill session-management) ---
# 1. Abra o vault existente na raiz da sua pasta de projetos (ex.: ~/Documents/dev)
#    NAO abra docs/obsidian/ deste projeto como vault separado - ele e so uma
#    subpasta do vault unico que ja cobre todos os repos (tribe-super-app, etc.)
# 2. Settings > Community plugins > desative o modo restrito > instale e ative "Local REST API"
# 3. Copie a API key em Settings > Local REST API
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124

# --- Context7 MCP (opcional) ---
# Funciona sem chave (rate limit menor). Para uma chave gratuita: https://context7.com/dashboard
CONTEXT7_API_KEY=
