# EditorConfig helps maintain consistent coding styles
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,kt}]
max_line_length = 120
indent_size = 4

[*.{xml,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,properties}]
indent_size = 2

[pom.xml]
indent_size = 4

[Dockerfile]
indent_size = 2

[docker-compose.yml]
indent_size = 2
