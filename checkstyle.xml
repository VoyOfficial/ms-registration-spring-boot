<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Checkstyle ruleset for ms-registration-spring-boot.

    Scope: structural/mechanical rules only (no Javadoc, no magic-number,
    no naming enforcement beyond what the compiler already requires).
    Formatting (indentation, whitespace, import order) is Spotless' job
    (see pom.xml `spotless-maven-plugin`) - this ruleset avoids duplicating it.

    Run: ./mvnw checkstyle:check
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>

    <module name="TreeWalker">
        <!-- Imports (complements code-conventions.mdc: "avoid wildcard imports for project classes").
             Static wildcard imports (e.g. `import static org.mockito.Mockito.*;`) are allowed since
             they are the idiomatic pattern for test assertions/matchers in this codebase. -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Structure -->
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>

        <!-- Common bug patterns -->
        <module name="EqualsHashCode"/>
        <module name="EmptyStatement"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_CATCH"/>
        </module>
    </module>
</module>
